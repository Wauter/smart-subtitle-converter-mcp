{
  "name": "smart-subtitle-converter-mcp",
  "version": "1.4.0",
  "description": "MCP server for the Smart Subtitle Converter API (community wrapper around Subtitle Edit libse; not an official Subtitle Edit project).",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "gen:types": "openapi-typescript openapi/openapi.v1.json -o src/api/types.gen.ts",
    "test": "vitest run --project unit --project mcp",
    "test:e2e": "vitest run --project e2e",
    "test:contract": "vitest run --project contract",
    "test:all": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wauter/smart-subtitle-converter-mcp.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "claude",
    "cursor",
    "subtitles",
    "subtitle-converter",
    "closed-captions",
    "srt",
    "webvtt",
    "ttml",
    "ebu-stl",
    "pac",
    "subtitle-edit",
    "broadcast",
    "media-workflow"
  ],
  "author": "Wauter De Bruyne",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Wauter/smart-subtitle-converter-mcp/issues"
  },
  "homepage": "https://github.com/Wauter/smart-subtitle-converter-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "type": "module",
  "bin": {
    "smart-subtitle-converter-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
